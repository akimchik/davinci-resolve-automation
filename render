#!/usr/bin/env bash

# Wrapper script for headless rendering
# Usage: ./render.sh -d 2026-06-20 [-l 1] [-g 300] [-m full] [-o custom_output.mp4]

# Set defaults
MODE="full"
DIVE_LIST=""
GAP="300" # Default gap to 5 mins based on our findings
DATE=""
OUTPUT=""

# Parse config.lua for directories
SEARCH_DIR=$(grep 'search_dir\s*=' config.lua | sed -E 's/.*=\s*"([^"]+)".*/\1/')
LOGS_DIR=$(grep 'logs_dir\s*=' config.lua | sed -E 's/.*=\s*"([^"]+)".*/\1/')

if [ -z "$SEARCH_DIR" ] || [ -z "$LOGS_DIR" ]; then
    echo "Error: Could not parse search_dir or logs_dir from config.lua."
    exit 1
fi

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -d|--date) DATE="$2"; shift ;;
        -m|--mode) MODE="$2"; shift ;;
        -l|--dive_list) DIVE_LIST="$2"; shift ;;
        -g|--gap) GAP="$2"; shift ;;
        -o|--output) OUTPUT="$2"; shift ;;
        *) echo "Unknown parameter passed: $1"; exit 1 ;;
    esac
    shift
done

if [ -z "$DATE" ]; then
    echo "Error: --date (-d) is required."
    echo "Usage: ./render.sh -d YYYY-MM-DD"
    exit 1
fi

if [ -z "$OUTPUT" ]; then
    OUTPUT="$HOME/Movies/dive_${DATE}"
    if [ -n "$DIVE_LIST" ]; then
        OUTPUT="${OUTPUT}_dive${DIVE_LIST}"
    fi
    OUTPUT="${OUTPUT}.mp4"
fi

CMD=(
    ".venv/bin/python3" "scripts/build_headless_movie.py"
    "--date" "$DATE"
    "--logs_dir" "$LOGS_DIR"
    "--media_dir" "$SEARCH_DIR"
    "--output" "$OUTPUT"
    "--mode" "$MODE"
    "--gap" "$GAP"
)

if [ -n "$DIVE_LIST" ]; then
    CMD+=("--dive_list" "$DIVE_LIST")
fi

echo "🎬 Starting headless render..."
echo "📅 Date: $DATE"
echo "🌊 Dives: ${DIVE_LIST:-All}"
echo "📁 Output: $OUTPUT"
echo "----------------------------------------"

"${CMD[@]}"
